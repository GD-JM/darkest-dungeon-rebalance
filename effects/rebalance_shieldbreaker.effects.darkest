// Rebalance mod - Shieldbreaker release-version effects (before the 19 June 2018 patch)
// New names only; vanilla effects stay untouched. See design/changes/shieldbreaker.md

// SB-003 break_guard speed debuff (release -2/-2/-3/-3/-4)
effect: .name "RB SB Daze Slowdown 1" .target "target" .chance 100% .combat_stat_buff 1 .speed_rating_add -2 .on_hit true .on_miss false .queue false
effect: .name "RB SB Daze Slowdown 2" .target "target" .chance 110% .combat_stat_buff 1 .speed_rating_add -2 .on_hit true .on_miss false .queue false
effect: .name "RB SB Daze Slowdown 3" .target "target" .chance 120% .combat_stat_buff 1 .speed_rating_add -3 .on_hit true .on_miss false .queue false
effect: .name "RB SB Daze Slowdown 4" .target "target" .chance 130% .combat_stat_buff 1 .speed_rating_add -3 .on_hit true .on_miss false .queue false
effect: .name "RB SB Daze Slowdown 5" .target "target" .chance 140% .combat_stat_buff 1 .speed_rating_add -4 .on_hit true .on_miss false .queue false

// SB-004 adders_kiss + single_out blight (release 2/2/3/3/4)
effect: .name "RB SB Adder Blight 1" .target "target" .curio_result_type "negative" .chance 100%  .dotPoison 2 .duration 3	.on_hit true .on_miss false .can_apply_on_death true
effect: .name "RB SB Adder Blight 2" .target "target" .curio_result_type "negative" .chance 110%  .dotPoison 2 .duration 3	.on_hit true .on_miss false .can_apply_on_death true
effect: .name "RB SB Adder Blight 3" .target "target" .curio_result_type "negative" .chance 120%  .dotPoison 3 .duration 3	.on_hit true .on_miss false .can_apply_on_death true
effect: .name "RB SB Adder Blight 4" .target "target" .curio_result_type "negative" .chance 130%  .dotPoison 3 .duration 3	.on_hit true .on_miss false .can_apply_on_death true
effect: .name "RB SB Adder Blight 5" .target "target" .curio_result_type "negative" .chance 140%  .dotPoison 4 .duration 3	.on_hit true .on_miss false .can_apply_on_death true

// SB-008 serpents_sway speed (release +3/3/4/4/5)
effect: .name "RB SB Serpent Speed 1" .target "performer" .curio_result_type "positive" .chance 100% .combat_stat_buff 1 .speed_rating_add 3	.on_hit true .on_miss false .queue true .apply_once true
effect: .name "RB SB Serpent Speed 2" .target "performer" .curio_result_type "positive" .chance 100% .combat_stat_buff 1 .speed_rating_add 3	.on_hit true .on_miss false .queue true .apply_once true
effect: .name "RB SB Serpent Speed 3" .target "performer" .curio_result_type "positive" .chance 100% .combat_stat_buff 1 .speed_rating_add 4	.on_hit true .on_miss false .queue true .apply_once true
effect: .name "RB SB Serpent Speed 4" .target "performer" .curio_result_type "positive" .chance 100% .combat_stat_buff 1 .speed_rating_add 4	.on_hit true .on_miss false .queue true .apply_once true
effect: .name "RB SB Serpent Speed 5" .target "performer" .curio_result_type "positive" .chance 100% .combat_stat_buff 1 .speed_rating_add 5	.on_hit true .on_miss false .queue true .apply_once true
