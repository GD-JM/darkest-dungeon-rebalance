// Workshop-only effects (creative-workshop build, not used by the custom mod). Referenced from design/workshop/changes.json "sub" ops.
// VES-W01 Illumination: vanilla Dodge Curse 1-5 (-20/-23/-25/-27/-30) lowered by 5 so it differs from Arbalest Sniper's Mark; pays for the added burn.
effect: .name "RB VES Illumination Dodge 1" .target "target" .curio_result_type "negative" .chance 100% .combat_stat_buff 1 .defense_rating_add -15% .on_hit true .on_miss false
effect: .name "RB VES Illumination Dodge 2" .target "target" .curio_result_type "negative" .chance 110% .combat_stat_buff 1 .defense_rating_add -18% .on_hit true .on_miss false
effect: .name "RB VES Illumination Dodge 3" .target "target" .curio_result_type "negative" .chance 120% .combat_stat_buff 1 .defense_rating_add -20% .on_hit true .on_miss false
effect: .name "RB VES Illumination Dodge 4" .target "target" .curio_result_type "negative" .chance 130% .combat_stat_buff 1 .defense_rating_add -22% .on_hit true .on_miss false
effect: .name "RB VES Illumination Dodge 5" .target "target" .curio_result_type "negative" .chance 140% .combat_stat_buff 1 .defense_rating_add -25% .on_hit true .on_miss false
// SB-W01 Impale: blight 1/1/2/2/3 for 3 turns from level 1 (levels 1-2 reuse vanilla SB Spearing Blight 1-2).
effect: .name "RB SB Impale Blight 3" .target "target" .curio_result_type "negative" .chance 120%  .dotPoison 2 .duration 3	.on_hit true .on_miss false .can_apply_on_death true
effect: .name "RB SB Impale Blight 4" .target "target" .curio_result_type "negative" .chance 130%  .dotPoison 2 .duration 3	.on_hit true .on_miss false .can_apply_on_death true
effect: .name "RB SB Impale Blight 5" .target "target" .curio_result_type "negative" .chance 140%  .dotPoison 3 .duration 3	.on_hit true .on_miss false .can_apply_on_death true

// ---- Musketeer (Workshop original rework, 2026-10-21) ----
// MUS-103 Piercing Ball vs marked: +25/29/33/37/40% damage, +9..13% crit (Arbalest Sniper Shot is +60..100%). / 관통탄 표식 대상 피해·치명.
effect: .name "RB MUS Pierce Tagged 1" .target "performer" .chance 100% .curio_result_type "positive" .keyStatus "tagged" .combat_stat_buff 1 .damage_low_multiply 25% .damage_high_multiply 25% .crit_chance_add 9% .on_hit true .on_miss false
